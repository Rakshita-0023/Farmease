# Server
PORT=5001
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-development-secret

# Database: omit DATABASE_URL for local SQLite (created with `npm run db:setup`).
# DATABASE_URL=postgresql://user:password@host:5432/farmease
# FARMEASE_DATABASE_PATH=farmease.db

# Optional intelligence service. The crop endpoint reports a clear degraded error
# if it is unavailable; legacy routes retain their documented fallback behavior.
ML_API_URL=http://127.0.0.1:8000
PLANT_DOCTOR_LOCAL_API_URL=http://127.0.0.1:8000
SENTINEL_ACCESS_TOKEN=
# Optional authorized Sentinel Hub Process API endpoint. Leave unset to expose a clean unavailable state.
SENTINEL_PROCESS_URL=
# PLANT_DOCTOR_API_URL=https://your-deployed-ml-service.example

# Optional providers. Open-Meteo works without a key. AGMARKNET live prices need
# an API key from data.gov.in; OpenWeatherMap is only a legacy fallback/geocoder.
AGMARKNET_API_KEY=
# IMD and eNAM are researched but not enabled providers in this release. Do not
# add undocumented credentials or scrape their portals; see docs/providers/.
OPENWEATHER_API_KEY=

# Optional authentication and browser configuration.
GOOGLE_CLIENT_ID=
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Comma-separated additions to the built-in local and production origins.
# CORS_ORIGINS=https://your-frontend.example

# Legacy market UI only: use LIVE in production. DEMO is explicitly opt-in and
# is never used by /api/v1.
MARKET_DATA_MODE=LIVE
