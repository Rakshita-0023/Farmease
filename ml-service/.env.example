# Comma-separated browser origins allowed to call this service directly.
# In normal development the frontend calls the backend, so the defaults are enough.
FARMEASE_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional identifier included in API metadata. Set this to a model release or hash when models change.
FARMEASE_MODEL_VERSION=unknown

# Test-only switch: validates API imports and fallback behavior without loading TensorFlow models.
FARMEASE_SKIP_MODEL_LOADING=false
